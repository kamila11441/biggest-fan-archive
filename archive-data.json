  "thoughts": [
    {
      "id": "1792097553995-vp0smw",
      "text": "you piss me off and you have a way of making me feel understood, even when I haven’t found the right words",
      "at": 1792097553995
    },
    {
      "id": "1792097504103-0h7xz2",
      "text": "I admire how you notice when someone needs a little extra care",
      "at": 1792097504103
    },
    {
      "id": "1792097451413-uop9m9",
      "text": "you make me want to be a little more patient, a little more generous🐣",
      "at": 1792097451413
    },
    {
      "id": "1792097230094-nrgb61",
      "text": "you are proof that grace can have a backbone",
      "at": 1792097230094
    },
    {
      "id": "1792097205323-1kkmeh",
      "text": "there’s music in the way you see things 🎶",
      "at": 1792097205323
    },
    {
      "id": "1792097160675-q74vr1",
      "text": "I admire how you turn kindness into something people can feel",
      "at": 1792097160675
    },
    {
      "id": "1792096981928-ca8to8",
      "text": "\"Believe you can and you're halfway there.\"",
      "at": 1792096981928
    },
    {
      "at": 1792069476312,
      "id": "1792069476312-y1jd0f",
      "text": "I am sure you smell good today!"
    }
